#!/usr/bin/env bash
# Block commits that contain credential-shaped strings.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0
# shellcheck disable=SC2086  # one path per line; repository paths contain no spaces
python3 scripts/scan_secrets.py $staged
