{
  "repo_dir": "/srv/aiwos/repo",
  "state_dir": "/var/lib/aiwos/state",
  "code_dir": "/opt/aiwos/code",
  "remote": "origin",
  "base_branch": "main",
  "task_globs": ["examples/*/task*.json", "tasks/*.json", "tasks/*/*.json"],
  "workers": 10,
  "model_concurrency": 2,
  "poll_interval_s": 10,
  "sync_interval_s": 120,
  "lease_ttl_s": 600,
  "heartbeat_s": 10,
  "stage_timeout_s": {"work": 900, "check": 600, "review": 600, "judge": 120, "resume": 60},
  "kill_grace_s": 30,
  "max_ai_runs_per_task": 6,
  "max_stage_attempts": 3,
  "agent_status_ttl_s": 600,
  "auth_recheck_s": 1800,
  "backoff_initial_s": 300,
  "backoff_max_s": 7200,
  "publish": "git",
  "agent_bins": {},
  "extra_path": []
}
