{
  "schema_version": "0.1",
  "task_id": "DOC-0001",
  "task_type": "document-compare",
  "objective": "製品仕様書 v1 と v2 を比較し、追加・削除・変更された項目を漏れなく一覧化する。",
  "inputs": [
    {
      "id": "doc-a",
      "kind": "file",
      "location": "examples/document-compare/inputs/spec-v1.txt",
      "description": "比較元（旧版）",
      "sensitivity": "public"
    },
    {
      "id": "doc-b",
      "kind": "file",
      "location": "examples/document-compare/inputs/spec-v2.txt",
      "description": "比較先（新版）",
      "sensitivity": "public"
    }
  ],
  "constraints": [
    "入力文書を書き換えない",
    "差異の判定根拠として行番号を併記する",
    "差異の解釈（影響評価）は事実と分けて書く"
  ],
  "acceptance_criteria": [
    {
      "id": "AC1",
      "description": "出力が「区分（追加/削除/変更）・旧版行・新版行・内容」の表形式である",
      "dimension": "spec_conformance",
      "verification": {
        "method": "inspection"
      }
    },
    {
      "id": "AC2",
      "description": "報告した差異がすべて機械 diff と一致し、変更のない行を差異として報告していない",
      "dimension": "correctness",
      "verification": {
        "method": "command",
        "command": "diff examples/document-compare/inputs/spec-v1.txt examples/document-compare/inputs/spec-v2.txt",
        "expected": "exit 1（差異あり）。出力の各ハンクが報告と1対1で対応する"
      }
    },
    {
      "id": "AC3",
      "description": "機械 diff が示すすべてのハンクが報告に含まれている（見落としゼロ）",
      "dimension": "completeness",
      "verification": {
        "method": "command",
        "command": "diff examples/document-compare/inputs/spec-v1.txt examples/document-compare/inputs/spec-v2.txt",
        "expected": "全ハンクが報告に対応する"
      }
    }
  ],
  "failure_conditions": [
    {
      "id": "FC1",
      "description": "機械 diff にある差異を見落とした",
      "on_trigger": "rework"
    },
    {
      "id": "FC2",
      "description": "存在しない差異を報告した",
      "on_trigger": "rework"
    },
    {
      "id": "FC3",
      "description": "入力文書が変更された",
      "on_trigger": "escalate"
    }
  ],
  "assigned_agent": "codex-cli",
  "reviewer": "claude-code",
  "status": "ready",
  "evidence": [],
  "quality": {
    "spec_conformance": {
      "verdict": "UNVERIFIED",
      "evidence_ids": [],
      "judged_by": null
    },
    "correctness": {
      "verdict": "UNVERIFIED",
      "evidence_ids": [],
      "judged_by": null
    },
    "completeness": {
      "verdict": "UNVERIFIED",
      "evidence_ids": [],
      "judged_by": null
    }
  },
  "retry_count": 0,
  "max_retries": 1,
  "escalation_reason": null,
  "history": [
    {
      "from": "draft",
      "to": "ready",
      "at": "2026-10-10T00:00:00Z",
      "by": "claude-code",
      "note": "Claude Code が起票し ready にした。Phase 1 では by: human と記録したが、人間による受入基準の確認は行われていない（Phase 2 で訂正）。時刻 00:00:00Z は Phase 1 作成時の概算（日付のみ正確）"
    }
  ]
}
