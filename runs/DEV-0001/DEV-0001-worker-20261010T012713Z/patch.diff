diff --git a/examples/development/src/greet.py b/examples/development/src/greet.py
index b0be052..8911564 100644
--- a/examples/development/src/greet.py
+++ b/examples/development/src/greet.py
@@ -1,5 +1,17 @@
 """Tiny target program for the development sample task (DEV-0001)."""
 
 
-def greet(name):
-    return f"Hello, {name}!"
+def greet(name, lang="en"):
+    """Return a greeting for ``name`` in the language ``lang``.
+
+    Supported languages:
+      - "en" (default): "Hello, <name>!"
+      - "ja": "こんにちは、<name>さん"
+
+    Any other ``lang`` raises ValueError; there is no silent fallback to English.
+    """
+    if lang == "en":
+        return f"Hello, {name}!"
+    if lang == "ja":
+        return f"こんにちは、{name}さん"
+    raise ValueError(f"unsupported lang: {lang!r}")
diff --git a/examples/development/src/test_greet.py b/examples/development/src/test_greet.py
index 5da708d..0e98863 100644
--- a/examples/development/src/test_greet.py
+++ b/examples/development/src/test_greet.py
@@ -7,6 +7,16 @@ class GreetTest(unittest.TestCase):
     def test_greets_by_name(self):
         self.assertEqual(greet("Ada"), "Hello, Ada!")
 
+    def test_greets_in_english_explicitly(self):
+        self.assertEqual(greet("Ada", lang="en"), "Hello, Ada!")
+
+    def test_greets_in_japanese(self):
+        self.assertEqual(greet("Ada", lang="ja"), "こんにちは、Adaさん")
+
+    def test_unsupported_lang_raises(self):
+        with self.assertRaises(ValueError):
+            greet("Ada", lang="fr")
+
 
 if __name__ == "__main__":
     unittest.main()
